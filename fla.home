        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="flamengo.css">

</head>

<body>

    <header class="bg-dark text-light p-3">
        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="bootstrap.html">C.R.F Clube Regatas do Flamengo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="home.html">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="historia.html">História</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="sobre nos.html">Sobre nós</a>
                        </li>
                    </ul>
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Pesquisar" aria-label="Search" />
                        <button class="btn btn-danger" type="submit">Entrar</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <section id="banner" class="bg-darkred p-2">
            <div id="banner01" class="banner principal">
                <div class="banner principal-item text-center" style="height: 55px;">
                    <h1>Flamengo:história, paixão e conquistas!</h1>
                </div>
            </div>
        </section>
    </main>

    <section id="p1">
        <div class="conteiner p-0">
            <div class="row">
                <div class="col-4 bg-darkred p-0">
                    <img src="br.jpg" alt="Maracanã" class="w-100" >
                </div>
                <div class="col-8 bg-dark text-light p-4">

                    O Flamengo é um dos clubes mais tradicionais e populares do Brasil.
                    Fundado em 1895, o clube construiu uma história marcada por grandes jogadores, conquistas
                    importantes e uma torcida apaixonada. Ao longo dos anos, o Flamengo se tornou um símbolo de força,
                    tradição e união entre seus torcedores.
                    
                    Sua trajetória é marcada por momentos históricos no futebol brasileiro e internacional, incluindo
                    títulos do Campeonato Brasileiro, Copa do Brasil, Libertadores e Mundial. Mais do que suas
                    conquistas, o Flamengo representa uma paixão que atravessa gerações e continua presente na vida de
                    milhões de torcedores.
                </div>
            </div>
        </div>
        </div>
    </section>
