css
.hearder-simples{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background-color: #1e293b;
    color: #ffffff;
    font-family: sans-serif;
}

.hearder-simples .logo{
    font-size: 20px;
    font-weight: bold;
}

.hearder-simples .menu{
    display: flex;
    list-style: none;
    gap: 20px;
    margin: 0;
    padding: 0;
}

.hearder-simples .menu a{
    color: #ffffff;
    text-decoration: none;
}

